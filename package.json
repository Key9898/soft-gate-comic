{
  "name": "soft-gate-comic",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @softgate/portal dev",
    "dev:ssr": "pnpm --filter @softgate/portal dev:ssr",
    "dev:api": "pnpm --filter @softgate/api dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"apps/portal/src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"apps/portal/server/**/*.ts\" \"apps/portal/scripts/**/*.ts\" \"api/**/*.ts\" \"apps/api/**/*.{ts,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"wiki/**/*.{md,mdx}\"",
    "format:check": "prettier --check \"apps/portal/src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"apps/portal/server/**/*.ts\" \"apps/portal/scripts/**/*.ts\" \"api/**/*.ts\" \"apps/api/**/*.{ts,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"wiki/**/*.{md,mdx}\"",
    "preview": "pnpm --filter @softgate/portal preview",
    "storybook": "pnpm --filter @softgate/portal storybook",
    "build-storybook": "pnpm --filter @softgate/portal build-storybook",
    "test": "pnpm --filter @softgate/portal test",
    "test:ui": "pnpm --filter @softgate/portal test:ui",
    "test:run": "turbo run test:run",
    "test:coverage": "pnpm --filter @softgate/portal test:coverage",
    "check": "pnpm lint && pnpm format:check && turbo run test:run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ],
    "wiki/**/*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.5.8",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "browser-tabs-lock",
      "prisma",
      "@prisma/engines"
    ]
  }
}
