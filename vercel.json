{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ranking", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/categories/:slug", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/webtoon/:id", "destination": "/index.html" },
    { "source": "/author/:id", "destination": "/index.html" },
    { "source": "/read/:webtoonId/:episodeNumber", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" },
    { "source": "/coins", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/creators", "destination": "/index.html" },
    { "source": "/press", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/reset-password/:token", "destination": "/index.html" }
  ]
}
