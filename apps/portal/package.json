{
  "name": "@softgate/portal",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:spa": "vite",
    "dev:ssr": "tsx server/dev.ts",
    "build": "tsc -b && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && tsx scripts/generate-sitemap.ts",
    "preview": "tsx server/index.ts",
    "generate:og": "tsx scripts/generate-og-images.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@softgate/contracts": "workspace:*",
    "@softgate/shared": "workspace:*",
    "framer-motion": "^11.0.8",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.10",
    "hono": "^4.7.0",
    "jsdom": "^29.1.0",
    "sharp": "^0.35.3",
    "storybook": "^8.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  }
}
