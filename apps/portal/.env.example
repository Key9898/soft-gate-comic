# Soft-Gate Comic User Portal Environment Variable Templates

# false = talk to local API (pnpm dev + pnpm dev:api). Vite does not load this example.
# Copy to gitignored `.env.development.local` for `pnpm dev` (mode=development).
# Do not put false in `.env` / `.env.local` — Vite also loads those in vitest (mode=test).
# Unset (Vercel without the var) stays mock. Do not set false on Vercel until a real API origin exists.
VITE_USE_MOCK_API=false

# URL of the deployed backend server API
VITE_API_BASE_URL=http://localhost:3000
