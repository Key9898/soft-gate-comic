NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# Optional. Added to the CORS allowlist when set. Do not guess Admin's local port.
# ADMIN_URL=
# Put your own JWT_SECRET in gitignored .env. Never commit a real secret.
JWT_SECRET=dev-only-not-for-production

# Empty = in-memory stub. Set = Prisma; boot fails if Postgres is down.
# Local Docker: pnpm --filter @softgate/api db:up && pnpm --filter @softgate/api db:migrate
# DATABASE_URL=postgresql://softgate:softgate@127.0.0.1:5432/softgate
# Leader public proxy also needs a database name. Omit DATABASE_URL until that name is known
# (a set URL with unreachable Postgres fails boot). Placeholder only — not a live server:
# DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/CHANGE_ME_DBNAME?sslmode=require
# R2: all four core slots = PutObject via SDK. Empty or partial = no send (R2_NOT_CONFIGURED).
# Keys are stored under portal/ on the shared bucket. No upload HTTP routes in this process.
# No R2_ENDPOINT. Bucket is R2_BUCKET, not a path on the account host.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public origin only (r2.dev or custom). Unset = put allowed, no public URL.
# R2_PUBLIC_BASE_URL=
# Brevo: key + from email = send HTML. Empty or partial = no send (MAIL_NOT_CONFIGURED).
# Forgot/reset HTTP still works without mail; no welcome mail in this process.
# Sender display name in code is SoftGate Comic. No BREVO_FROM_NAME slot.
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=
