    "@softgate/contracts": "workspace:*",
    "@softgate/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "jose": "^6.2.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.5"
  }
}
