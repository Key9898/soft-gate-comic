{
  "name": "@softgate/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://unused:unused@127.0.0.1:5432/unused prisma validate",
