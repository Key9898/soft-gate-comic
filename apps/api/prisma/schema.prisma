generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReaderUser {
  id            String              @id
  email         String              @unique
  username      String              @unique
  displayName   String
  avatar        String?
  bio           String              @default("")
  passwordHash  String
  createdAt     DateTime
  lastLoginAt   DateTime?
  refreshTokens  RefreshToken[]
  passwordResets ReaderPasswordReset[]
  wallet         Wallet?
  transactions  WalletTransaction[]
  unlocks       WalletUnlock[]
  librarySubscribes LibrarySubscribe[]
  libraryHistory    LibraryHistory[]
  libraryLikes      LibraryLike[]
  notifications     ReaderNotification[]
  prefs             ReaderUserPrefs?
  comments          ReaderComment[]
  commentLikes      ReaderCommentLike[]
}

model RefreshToken {
  jti    String     @id
  userId String
  user   ReaderUser @relation(fields: [userId], references: [id])
}

model ReaderPasswordReset {
  id        String     @id
  userId    String
  tokenHash String     @unique
  expiresAt DateTime
  user      ReaderUser @relation(fields: [userId], references: [id])
}

model Wallet {
  userId  String     @id
  balance Int
  seeded  Boolean
  user    ReaderUser @relation(fields: [userId], references: [id])
}

enum WalletTxnType {
  purchase
  spend
  refund
  bonus
  demo_topup
}

model WalletTransaction {
  id          String        @id
  userId      String
  type        WalletTxnType
  amount      Int
  description String
  balance     Int
  createdAt   DateTime
  packageId   String?
  episodeKey  String?
  user        ReaderUser    @relation(fields: [userId], references: [id])
}

model WalletUnlock {
  userId     String
  episodeKey String
  user       ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, episodeKey])
}

model LibrarySubscribe {
  userId                    String
  webtoonId                 String
  addedAt                   DateTime
  notifyMuted               Boolean @default(false)
  lastNotifiedEpisodeNumber Int?
  user                      ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

model LibraryHistory {
  userId             String
  webtoonId          String
  episodeNumber      Int
  lastReadAt         DateTime
  scrollRatio        Float?
  readEpisodeNumbers Int[]   @default([])
  user               ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

model LibraryLike {
  userId    String
  webtoonId String
  likedAt   DateTime
  user      ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, webtoonId])
}

enum ReaderNotificationType {
  new_episode
  comment_reply
  system
  promotion
}

model ReaderNotification {
  userId        String
  id            String
  type          ReaderNotificationType
  titleKey      String
  message       String
  isRead        Boolean
  createdAt     DateTime
  href          String?
  webtoonId     String?
  episodeNumber Int?
  user          ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, id])
}

enum ReaderFontSize {
  sm
  md
  lg
}

enum ReaderImageFit {
  fit
  full
}

model ReaderUserPrefs {
  userId       String         @id
  newEpisode   Boolean        @default(true)
  commentReply Boolean        @default(true)
  promotion    Boolean        @default(true)
  darkMode     Boolean        @default(true)
  brightness   Float          @default(0.9)
  fontSize     ReaderFontSize @default(md)
  imageFit     ReaderImageFit @default(fit)
  user         ReaderUser     @relation(fields: [userId], references: [id])
}

model ReaderComment {
  id        String   @id
  episodeKey String
  userId    String
  content   String
  parentId  String?
  spoiler   Boolean  @default(false)
  reported  Boolean  @default(false)
  isEdited  Boolean  @default(false)
  createdAt DateTime
  user      ReaderUser @relation(fields: [userId], references: [id])
  likes     ReaderCommentLike[]

  @@index([episodeKey])
}

model ReaderCommentLike {
  commentId String
  userId    String
  comment   ReaderComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      ReaderUser    @relation(fields: [userId], references: [id])

  @@id([commentId, userId])
}

enum AuthorStatus {
  active
  inactive
}

enum WebtoonStatus {
  ongoing
  completed
  hiatus
  draft
}

enum EpisodeStatus {
  published
  draft
  scheduled
}

model Author {
  id            String       @id @default(uuid())
  name          Json
  bio           Json?
  avatar        String?
  followerCount Int          @default(0)
  status        AuthorStatus @default(active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  webtoons      Webtoon[]
}

model Genre {
  id        String         @id @default(uuid())
  name      Json
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  webtoons  WebtoonGenre[]
}

model Webtoon {
  id              String         @id @default(uuid())
  title           Json
  description     Json
  coverImage      String?
  coverColor      String         @default("")
  authorId        String
  author          Author         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags            String[]
  status          WebtoonStatus
  isPremium       Boolean        @default(false)
  viewCount       Int            @default(0)
  likeCount       Int            @default(0)
  rating          Float          @default(0)
  contentRating   String
  spotlight       Boolean        @default(false)
  spotlightOrder  Int?
  weeklyViewCount Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  genres          WebtoonGenre[]
  episodes        Episode[]
}

model WebtoonGenre {
  webtoonId String
  genreId   String
  webtoon   Webtoon @relation(fields: [webtoonId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([webtoonId, genreId])
}

model Episode {
  id            String        @id @default(uuid())
  webtoonId     String
  webtoon       Webtoon       @relation(fields: [webtoonId], references: [id], onDelete: Restrict)
  title         Json
  description   Json?
  images        String[]
  imageSizes    Json?
  isPremium     Boolean       @default(false)
  coinPrice     Int           @default(0)
  viewCount     Int           @default(0)
  likeCount     Int           @default(0)
  episodeNumber Int
  status        EpisodeStatus
  freeAt        DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([webtoonId, episodeNumber])
}
