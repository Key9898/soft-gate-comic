generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReaderUser {
  id            String              @id
  email         String              @unique
  username      String              @unique
  displayName   String
  avatar        String?
  bio           String              @default("")
  passwordHash  String
  createdAt     DateTime
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  wallet        Wallet?
  transactions  WalletTransaction[]
  unlocks       WalletUnlock[]
}

model RefreshToken {
  jti    String     @id
  userId String
  user   ReaderUser @relation(fields: [userId], references: [id])
}

model Wallet {
  userId  String     @id
  balance Int
  seeded  Boolean
  user    ReaderUser @relation(fields: [userId], references: [id])
}

enum WalletTxnType {
  purchase
  spend
  refund
  bonus
  demo_topup
}

model WalletTransaction {
  id          String        @id
  userId      String
  type        WalletTxnType
  amount      Int
  description String
  balance     Int
  createdAt   DateTime
  packageId   String?
  episodeKey  String?
  user        ReaderUser    @relation(fields: [userId], references: [id])
}

model WalletUnlock {
  userId     String
  episodeKey String
  user       ReaderUser @relation(fields: [userId], references: [id])

  @@id([userId, episodeKey])
}
